# ============================================================
# Configuração do latexmk para este projeto.
#
# latexmk detecta sozinho que o documento usa BibLaTeX + Biber
# (a partir do arquivo .run.xml) e roda a sequência correta:
#   pdflatex -> biber -> pdflatex -> pdflatex
#
# Uso:
#   No terminal, dentro da pasta do projeto:
#     latexmk main.tex
#   Para limpar todos os arquivos auxiliares gerados:
#     latexmk -c
#
# No TexWorks: Editar > Preferências > Typesetting > adicione uma
# nova ferramenta chamada "latexmk" com:
#   Programa:  latexmk
#   Argumentos: -pdf  -interaction=nonstopmode  -synctex=1  $fullbasename
# e marque essa ferramenta como padrão. Assim um único "Typeset"
# (Ctrl+T) já roda pdflatex+biber+pdflatex automaticamente.
# ============================================================
$pdf_mode = 1;
$pdflatex = 'pdflatex -interaction=nonstopmode -synctex=1 %O %S';
