% ============================================================
% meutrabalho.sty — template acadêmico pessoal
% Nícolas Terleski de Oliveira
%
% Uso básico:
%   \documentclass[a4paper]{article}
%   \usepackage{meutrabalho}
%
% Opções (para trabalhos que não precisam de tudo):
%   semcodigo      -> não carrega listings/algoritmos/tcolorbox de código
%   semreferencias -> não carrega biblatex/biber (dispensa references.bib)
%
% Exemplo (matemática pura, sem código nem referências):
%   \usepackage[semcodigo,semreferencias]{meutrabalho}
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{meutrabalho}[2026/08/16 template acadêmico pessoal v1.6]

\newif\ifmt@programming  \mt@programmingtrue
\newif\ifmt@references   \mt@referencestrue

\DeclareOption{semcodigo}{\mt@programmingfalse}
\DeclareOption{semreferencias}{\mt@referencesfalse}
\DeclareOption*{\PackageWarning{meutrabalho}{Opção desconhecida: '\CurrentOption'}}
\ProcessOptions\relax

% ---------- Núcleo (sempre carregado) ----------
\RequirePackage{meutrabalho/modules/mt-layout}
\RequirePackage{meutrabalho/modules/mt-matematica}
% cleveref precisa ser carregado depois do amsmath (mathematics.sty)
\RequirePackage[capitalize,noabbrev]{cleveref}
\RequirePackage{meutrabalho/modules/mt-exercicios}
\RequirePackage{meutrabalho/modules/mt-graficos}

% ---------- Módulos opcionais ----------
\ifmt@programming
    \RequirePackage{meutrabalho/modules/mt-programacao}
\fi
\ifmt@references
    \RequirePackage{meutrabalho/modules/mt-referencias}
\fi

% ============================================================
% Nomes em português para \cref/\Cref (cleveref não detecta
% automaticamente o idioma a partir do babel neste template).
% ============================================================
\crefname{figure}{figura}{figuras}
\Crefname{figure}{Figura}{Figuras}
\crefname{table}{tabela}{tabelas}
\Crefname{table}{Tabela}{Tabelas}
\crefname{equation}{equação}{equações}
\Crefname{equation}{Equação}{Equações}
\crefname{section}{seção}{seções}
\Crefname{section}{Seção}{Seções}
\crefname{subsection}{seção}{seções}
\Crefname{subsection}{Seção}{Seções}

\crefname{definicao}{definição}{definições}
\Crefname{definicao}{Definição}{Definições}
\crefname{teorema}{teorema}{teoremas}
\Crefname{teorema}{Teorema}{Teoremas}
\crefname{proposicao}{proposição}{proposições}
\Crefname{proposicao}{Proposição}{Proposições}
\crefname{lema}{lema}{lemas}
\Crefname{lema}{Lema}{Lemas}
\crefname{corolario}{corolário}{corolários}
\Crefname{corolario}{Corolário}{Corolários}
\crefname{exemplo}{exemplo}{exemplos}
\Crefname{exemplo}{Exemplo}{Exemplos}
\crefname{observacao}{observação}{observações}
\Crefname{observacao}{Observação}{Observações}

\crefname{questao}{questão}{questões}
\Crefname{questao}{Questão}{Questões}

\ifmt@programming
    % cleveref usa \crefalias{lstlisting}{listing} internamente,
    % então o nome em português é definido para o tipo "listing".
    \crefname{listing}{código}{códigos}
    \Crefname{listing}{Código}{Códigos}
    \crefname{algorithm}{algoritmo}{algoritmos}
    \Crefname{algorithm}{Algoritmo}{Algoritmos}
\fi

\endinput
