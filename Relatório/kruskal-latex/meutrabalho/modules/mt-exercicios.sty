% ============================================================
% meutrabalho / modules / exercises.sty
% Questões, exercícios, soluções e respostas — numeração única
% compartilhada, útil tanto para listas de Matemática quanto
% para listas de exercícios de programação.
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{meutrabalho/modules/mt-exercicios}[2026/08/16 exercises v1.6]

\RequirePackage{etoolbox}
\RequirePackage{enumitem}

\newcounter{questao}
\renewcommand{\thequestao}{\arabic{questao}}

% \questao[label]{enunciado} -- forma curta, em linha
\newcommand{\questao}[2][]{%
    \refstepcounter{questao}%
    \par\medskip\noindent
    \textbf{\textcolor{primary}{Questão~\thequestao.}} #2\par
    \notblank{#1}{\label{#1}}{}%
    \medskip
}

% \begin{exercicio}[label] ... \end{exercicio} -- forma em bloco,
% para enunciados mais longos, com itens, figuras, etc.
\newenvironment{exercicio}[1][]{%
    \refstepcounter{questao}%
    \par\medskip\noindent
    \textbf{\textcolor{primary}{Exercício~\thequestao.}}\notblank{#1}{\label{#1}}{}\ %
}{%
    \par\medskip
}

\newenvironment{solucao}{%
    \par\noindent\textit{Solução.}\ %
}{%
    \hfill$\blacksquare$\par\medskip
}

\newenvironment{resposta}{%
    \par\noindent\textbf{Resposta:}\ %
}{%
    \par\medskip
}

% ============================================================
% subquestoes: itens "a) b) c)" dentro de uma questão/exercício
% (o que a ABNT chama de "alíneas"). Cada \item pode conter seu
% próprio \begin{resposta}...\end{resposta} ou \begin{solucao}.
%
%   \begin{exercicio}
%       Contexto da questão...
%   \end{exercicio}
%   \begin{subquestoes}
%       \item Enunciado do item a).
%       \begin{resposta} ... \end{resposta}
%       \item Enunciado do item b).
%       \begin{resposta} ... \end{resposta}
%   \end{subquestoes}
% ============================================================
\newlist{subquestoes}{enumerate}{1}
\setlist[subquestoes]{
    label=\textbf{\textcolor{primary}{\alph*)}},
    leftmargin=1.5em,
    itemsep=0.5em,
    topsep=0.3em
}

\endinput
