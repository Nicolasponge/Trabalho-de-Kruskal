% ============================================================
% meutrabalho / modules / graphics.sty
% Figuras, gráficos de função (pgfplots), diagramas/grafos e
% árvores desenhados direto no LaTeX (sem precisar exportar SVG).
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{meutrabalho/modules/mt-graficos}[2026/08/16 graphics v1.6]

\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{subcaption}
\captionsetup{font=small, labelfont=bf, labelsep=colon}

% ---------- Tabelas ----------
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{multirow}

% ---------- Gráficos de função ----------
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

% ---------- Diagramas, grafos e árvores ----------
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, calc, shapes.geometric, quotes}
\usetikzlibrary{graphs, graphs.standard}
\RequirePackage{forest}
\RequirePackage{xparse}

% ============================================================
% \imagem[largura]{arquivo}{legenda}{label}
% Para fotos, prints, gráficos exportados do Desmos/GeoGebra etc.
% ============================================================
\newcommand{\imagem}[4][0.75\textwidth]{%
    \begin{figure}[H]
        \centering
        \includegraphics[width=#1]{#2}
        \caption{#3}
        \label{#4}
    \end{figure}
}

% ============================================================
% \funcao[xmin][xmax]{expressão}{legenda}{label}
% Gráfico rápido de uma função de uma variável, nativo em LaTeX.
% xmin/xmax são opcionais (padrão: -5 e 5).
% Ex.: \funcao[-2][2]{x^2}{Gráfico de $f(x)=x^2$.}{fig:parabola}
% ============================================================
\NewDocumentCommand{\funcao}{O{-5} O{5} m m m}{%
    \begin{figure}[H]
        \centering
        \begin{tikzpicture}
            \begin{axis}[
                width=0.8\textwidth,
                axis lines=middle,
                grid=major,
                xlabel={$x$}, ylabel={$y$},
                xmin=#1, xmax=#2,
                samples=150
            ]
                \addplot[primary, thick, domain=#1:#2] {#3};
            \end{axis}
        \end{tikzpicture}
        \caption{#4}
        \label{#5}
    \end{figure}
}

% ============================================================
% diagrama: moldura de figura genérica para TikZ/forest --
% use para grafos, árvores, autômatos, fluxogramas, redes, etc.
%
%   \begin{diagrama}{legenda}{label}
%       \begin{tikzpicture}
%           ...
%       \end{tikzpicture}
%   \end{diagrama}
%
% Layout automático de grafos (spring/tree) exige compilar com
% LuaLaTeX e \usetikzlibrary{graphdrawing, graphdrawing.trees}.
% Com pdfLaTeX, posicione os nós manualmente (veja os exemplos).
% ============================================================
\NewDocumentEnvironment{diagrama}{m m}{%
    \begin{figure}[H]
    \centering
}{%
    \caption{#1}\label{#2}
    \end{figure}
}

\endinput
