\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{meutrabalho/modules/mt-matematica}[2026/08/16 mathematics v1.6]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{mathtools}

% ---------- Ambientes de teorema (numeração contínua e única) ----------
\newtheorem{definicao}{Definição}
\newtheorem{teorema}{Teorema}
\newtheorem{proposicao}{Proposição}
\newtheorem{lema}{Lema}
\newtheorem{corolario}{Corolário}

\theoremstyle{remark}
\newtheorem{exemplo}{Exemplo}
\newtheorem{observacao}{Observação}

\renewcommand{\proofname}{Demonstração}

% ---------- Caixas de destaque (usam tcolorbox, carregado em layout.sty) ----------
\newtcolorbox{importante}{%
    colback=lightgray, colframe=primary,
    title=Importante, fonttitle=\bfseries, boxrule=0.5pt
}
\newtcolorbox{complexidade}{%
    colback=lightgray, colframe=primary,
    title=Complexidade, fonttitle=\bfseries, boxrule=0.5pt
}

\endinput
