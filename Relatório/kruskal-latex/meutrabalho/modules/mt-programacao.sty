% ============================================================
% meutrabalho / modules / programming.sty
% Código-fonte (Java/C/C++/Python), algoritmos em pseudocódigo,
% caixas de entrada/saída/terminal.
% Desative com \usepackage[semcodigo]{meutrabalho} em trabalhos
% de matemática pura, se quiser evitar carregar este módulo.
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{meutrabalho/modules/mt-programacao}[2026/08/16 programming v1.6]

\RequirePackage{listings}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}

% ---------- Cores de código ----------
\definecolor{codebackground}{HTML}{F5F5F5}
\definecolor{codeborder}{HTML}{D0D0D0}
\definecolor{codecomment}{HTML}{5F6B5F}
\definecolor{codestring}{HTML}{7A3E00}

\lstset{
    basicstyle=\ttfamily\small,
    backgroundcolor=\color{codebackground},
    frame=single,
    rulecolor=\color{codeborder},
    numbers=left,
    numberstyle=\scriptsize\color{secondary},
    numbersep=10pt,
    breaklines=true,
    breakatwhitespace=false,
    showstringspaces=false,
    keepspaces=true,
    tabsize=4,
    captionpos=b,
    columns=fullflexible,
    % Permite acentos/cedilha em comentários e strings do código-fonte
    % (comum em Java/C++/Python escritos em português).
    extendedchars=true,
    literate=%
        {á}{{\'a}}1 {à}{{\`a}}1 {ã}{{\~a}}1 {â}{{\^a}}1 {ä}{{\"a}}1
        {é}{{\'e}}1 {è}{{\`e}}1 {ê}{{\^e}}1 {ë}{{\"e}}1
        {í}{{\'i}}1 {ì}{{\`i}}1 {î}{{\^i}}1 {ï}{{\"i}}1
        {ó}{{\'o}}1 {ò}{{\`o}}1 {õ}{{\~o}}1 {ô}{{\^o}}1 {ö}{{\"o}}1
        {ú}{{\'u}}1 {ù}{{\`u}}1 {û}{{\^u}}1 {ü}{{\"u}}1
        {ç}{{\c c}}1
        {Á}{{\'A}}1 {À}{{\`A}}1 {Ã}{{\~A}}1 {Â}{{\^A}}1 {Ä}{{\"A}}1
        {É}{{\'E}}1 {È}{{\`E}}1 {Ê}{{\^E}}1 {Ë}{{\"E}}1
        {Í}{{\'I}}1 {Ì}{{\`I}}1 {Î}{{\^I}}1 {Ï}{{\"I}}1
        {Ó}{{\'O}}1 {Ò}{{\`O}}1 {Õ}{{\~O}}1 {Ô}{{\^O}}1 {Ö}{{\"O}}1
        {Ú}{{\'U}}1 {Ù}{{\`U}}1 {Û}{{\^U}}1 {Ü}{{\"U}}1
        {Ç}{{\c C}}1
        {£}{{\pounds}}1
}

\lstdefinestyle{java}{
    language=Java,
    keywordstyle=\color{primary}\bfseries,
    commentstyle=\color{codecomment}\itshape,
    stringstyle=\color{codestring}
}
\lstdefinestyle{cpp}{
    language=C++,
    keywordstyle=\color{primary}\bfseries,
    commentstyle=\color{codecomment}\itshape,
    stringstyle=\color{codestring}
}
\lstdefinestyle{c}{
    language=C,
    keywordstyle=\color{primary}\bfseries,
    commentstyle=\color{codecomment}\itshape,
    stringstyle=\color{codestring}
}
\lstdefinestyle{python}{
    language=Python,
    keywordstyle=\color{primary}\bfseries,
    commentstyle=\color{codecomment}\itshape,
    stringstyle=\color{codestring}
}

% ---------- Lista de códigos ----------
\renewcommand{\lstlistingname}{Código}
\renewcommand{\lstlistlistingname}{Lista de Códigos}
\newcommand{\listadecodigos}{\lstlistoflistings\clearpage}

% ---------- Comandos para importar arquivos de código ----------
\newcommand{\codigojava}[2][]{\lstinputlisting[style=java,#1]{#2}}
\newcommand{\codigocpp}[2][]{\lstinputlisting[style=cpp,#1]{#2}}
\newcommand{\codigoc}[2][]{\lstinputlisting[style=c,#1]{#2}}
\newcommand{\codigopython}[2][]{\lstinputlisting[style=python,#1]{#2}}

% ---------- Entrada / Saída / Terminal ----------
\newtcolorbox{entrada}{
    colback=lightgray, colframe=primary,
    title=Entrada, fonttitle=\bfseries, fontupper=\ttfamily\small, boxrule=0.5pt
}
\newtcolorbox{saida}{
    colback=lightgray, colframe=primary,
    title=Saída, fonttitle=\bfseries, fontupper=\ttfamily\small, boxrule=0.5pt
}
\newtcolorbox{terminal}{
    colback=black!95, colframe=black!95,
    fontupper=\ttfamily\small\color{white},
    title=Terminal, coltitle=white, colbacktitle=black!95
}

\endinput
