% ============================================================
% meutrabalho / modules / references.sty
% Referências bibliográficas via BibLaTeX + Biber, estilo ABNT.
% Desative com \usepackage[semreferencias]{meutrabalho} se o
% trabalho não usa references.bib.
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{meutrabalho/modules/mt-referencias}[2026/08/16 references v1.6]

\RequirePackage{csquotes}
\RequirePackage[
    backend=biber,
    style=abnt,
    language=brazilian
]{biblatex}

% Por convenção, o arquivo de referências do projeto se chama
% "references.bib" e fica na raiz (junto com main.tex).
\addbibresource{references.bib}

\newcommand{\references}{%
    \printbibliography[heading=bibintoc, title={Referências}]
}

\endinput
